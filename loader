function VoidUI:CreateWindow(options)
    options = options or {}
    local title   = options.Title    or "VoidUI"
    local size    = options.Size     or UDim2.new(0, 560, 0, 420)
    local pos     = options.Position or UDim2.new(0.5, -280, 0.5, -210)

    local sg = New("ScreenGui", {
        Name           = "VoidUI_" .. title,
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    pcall(function() sg.Parent = CoreGui end)
    if not sg.Parent then sg.Parent = LocalPlayer.PlayerGui end

    local win = New("Frame", {
        Size             = size,
        Position         = pos,
        BackgroundColor3 = Theme.Background,
        ClipsDescendants = false,
    }, sg)
