                    BackgroundColor3 = Theme.SurfaceAlt,
                }, sec)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                New("TextLabel", {
                    Size                  = UDim2.new(0.4, 0, 1, 0),
                    Position              = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text                  = label,
                    Font                  = Theme.FontLight,
                    TextSize              = 12,
                    TextColor3            = Theme.Text,
                    TextXAlignment        = Enum.TextXAlignment.Left,
                }, row)

                local input = New("TextBox", {
                    Size              = UDim2.new(0.55, 0, 0, 22),
                    Position          = UDim2.new(0.42, 0, 0.5, -11),
                    BackgroundColor3  = Theme.Background,
                    Text              = default,
                    PlaceholderText   = placeholder,
                    Font              = Theme.FontRegular,
                    TextSize          = 11,
                    TextColor3        = Theme.Text,
                    PlaceholderColor3 = Theme.TextDisabled,
                    ClearTextOnFocus  = false,
                    TextXAlignment    = Enum.TextXAlignment.Left,
                }, row)
                Corner(input, Theme.CornerSmall)
                local inputStroke = Stroke(input, Theme.Border)
                Padding(input, nil, 0, 0, 8, 8)

                input.Focused:Connect(function()
                    Tween(input, { BackgroundColor3 = Color3.fromRGB(28, 28, 28) })
                    inputStroke.Color = Theme.AccentDim
                end)
                input.FocusLost:Connect(function(enter)
                    Tween(input, { BackgroundColor3 = Theme.Background })
                    inputStroke.Color = Theme.Border
                    callback(input.Text, enter)
                end)

                local Input = {}
                function Input:Set(val) input.Text = val; callback(val, false) end
                function Input:Get() return input.Text end
                return Input
            end

            -- ── KEYBIND ──
            function Section:CreateKeybind(opts)
                opts = type(opts) == "string" and { Name = opts } or opts
                local label    = opts.Name     or "Keybind"
                local default  = opts.Default  or Enum.KeyCode.Unknown
                local callback = opts.Callback or function() end

                local bound   = default
                local waiting = false

                local row = New("Frame", {
                    Size             = UDim2.new(1, 0, 0, 38),
                    BackgroundColor3 = Theme.SurfaceAlt,
                }, sec)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                New("TextLabel", {
                    Size                  = UDim2.new(0.6, 0, 1, 0),
                    Position              = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text                  = label,
                    Font                  = Theme.FontLight,
                    TextSize              = 12,
                    TextColor3            = Theme.Text,
                    TextXAlignment        = Enum.TextXAlignment.Left,
                }, row)

                local keyBtn = New("TextButton", {
                    Size             = UDim2.new(0, 80, 0, 22),
                    Position         = UDim2.new(1, -90, 0.5, -11),
                    BackgroundColor3 = Theme.Background,
                    Text             = bound.Name,
                    Font             = Theme.Font,
                    TextSize         = 10,
                    TextColor3       = Theme.AccentDim,
                    AutoButtonColor  = false,
                }, row)
                Corner(keyBtn, Theme.CornerSmall)
                Stroke(keyBtn, Theme.Border)

                keyBtn.MouseButton1Click:Connect(function()
                    waiting = true
                    keyBtn.Text = "..."
                    Tween(keyBtn, { TextColor3 = Theme.Text })
                end)

                UserInputService.InputBegan:Connect(function(input, gp)
                    if not waiting then
                        if input.KeyCode == bound then callback(bound) end
                        return
                    end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        waiting = false
                        bound   = input.KeyCode
                        keyBtn.Text = bound.Name
                        Tween(keyBtn, { TextColor3 = Theme.AccentDim })
                    end
                end)

                local Keybind = {}
                function Keybind:Set(key) bound = key; keyBtn.Text = key.Name end
                function Keybind:Get() return bound end
                return Keybind
            end

            -- ── COLOR PICKER ──
            function Section:CreateColorPicker(opts)
                opts = type(opts) == "string" and { Name = opts } or opts
                local label    = opts.Name     or "Color"
                local default  = opts.Default  or Color3.new(1, 1, 1)
                local callback = opts.Callback or function() end

                local color    = default
                local open     = false
                local h, s, v  = Color3.toHSV(color)

                local container = New("Frame", {
                    Size             = UDim2.new(1, 0, 0, 36),
                    BackgroundTransparency = 1,
                    ClipsDescendants = false,
                    ZIndex           = 4,
                }, sec)

                local row = New("Frame", {
                    Size             = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = Theme.SurfaceAlt,
                    ZIndex           = 4,
                }, container)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                New("TextLabel", {
                    Size                  = UDim2.new(0.6, 0, 1, 0),
                    Position              = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text                  = label,
                    Font                  = Theme.FontLight,
                    TextSize              = 12,
                    TextColor3            = Theme.Text,
                    TextXAlignment        = Enum.TextXAlignment.Left,
                    ZIndex                = 4,
                }, row)

                local preview = New("Frame", {
                    Size             = UDim2.new(0, 48, 0, 20),
                    Position         = UDim2.new(1, -60, 0.5, -10),
                    BackgroundColor3 = color,
                    ZIndex           = 4,
                }, row)
                Corner(preview, Theme.CornerSmall)
                Stroke(preview, Theme.Border)

                local panel = New("Frame", {
                    Size             = UDim2.new(1, 0, 0, 160),
                    Position         = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = Theme.Surface,
                    ClipsDescendants = false,
                    ZIndex           = 8,
                    Visible          = false,
                }, container)
                Corner(panel, Theme.CornerMedium)
                Stroke(panel, Theme.Border)

                local svSquare = New("ImageLabel", {
                    Size             = UDim2.new(0, 120, 0, 120),
                    Position         = UDim2.new(0, 10, 0, 10),
                    BackgroundColor3 = Color3.fromHSV(h, 1, 1),
                    Image            = "rbxassetid://4155801252",
                    ZIndex           = 8,
                }, panel)
                Corner(svSquare, Theme.CornerSmall)

                local svThumb = New("Frame", {
                    Size             = UDim2.new(0, 10, 0, 10),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    ZIndex           = 9,
                }, svSquare)
                Corner(svThumb, 5)
                Stroke(svThumb, Color3.new(0, 0, 0), 1)

                local hueBar = New("ImageLabel", {
                    Size     = UDim2.new(0, 16, 0, 120),
                    Position = UDim2.new(0, 138, 0, 10),
                    Image    = "rbxassetid://698051777",
                    ZIndex   = 8,
                }, panel)
                Corner(hueBar, Theme.CornerSmall)

                local hueThumb = New("Frame", {
                    Size             = UDim2.new(1, 4, 0, 4),
                    Position         = UDim2.new(0, -2, 0, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    ZIndex           = 9,
                }, hueBar)
                Corner(hueThumb, 2)
                Stroke(hueThumb, Color3.new(0, 0, 0), 1)

                local rgbLabel = New("TextLabel", {
                    Size                  = UDim2.new(1, -170, 0, 40),
                    Position              = UDim2.new(0, 162, 0, 10),
                    BackgroundTransparency = 1,
                    Text                  = string.format("R: %d\nG: %d\nB: %d",
                        math.round(color.R*255), math.round(color.G*255), math.round(color.B*255)),
                    Font                  = Theme.FontRegular,
                    TextSize              = 10,
                    TextColor3            = Theme.TextMuted,
                    TextXAlignment        = Enum.TextXAlignment.Left,
                    ZIndex                = 8,
                }, panel)

                local function UpdateColor()
                    color = Color3.fromHSV(h, s, v)
                    preview.BackgroundColor3  = color
                    svSquare.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                    svThumb.Position   = UDim2.new(s, -5, 1 - v, -5)
                    hueThumb.Position  = UDim2.new(0, -2, 1 - h, -2)
                    rgbLabel.Text      = string.format("R: %d\nG: %d\nB: %d",
                        math.round(color.R*255), math.round(color.G*255), math.round(color.B*255))
                    callback(color)
                end

                local svDrag = false
                local svBtn  = New("TextButton", { Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=9 }, svSquare)
                svBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then svDrag = true end end)
                svBtn.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then svDrag = false end end)
                UserInputService.InputChanged:Connect(function(i)
                    if svDrag and i.UserInputType == Enum.UserInputType.MouseMovement then
                        local rel = svSquare.AbsolutePosition; local sz = svSquare.AbsoluteSize
                        s = math.clamp((i.Position.X - rel.X) / sz.X, 0, 1)
                        v = math.clamp(1 - (i.Position.Y - rel.Y) / sz.Y, 0, 1)
                        UpdateColor()
                    end
                end)

                local hueDrag = false
                local hueBtn  = New("TextButton", { Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=9 }, hueBar)
                hueBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = true end end)
                hueBtn.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = false end end)
                UserInputService.InputChanged:Connect(function(i)
                    if hueDrag and i.UserInputType == Enum.UserInputType.MouseMovement then
                        local rel = hueBar.AbsolutePosition; local sz = hueBar.AbsoluteSize
                        h = math.clamp(1 - (i.Position.Y - rel.Y) / sz.Y, 0, 1)
                        UpdateColor()
                    end
                end)

                local openBtn = New("TextButton", { Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=5 }, row)
                openBtn.MouseButton1Click:Connect(function()
                    open = not open
                    panel.Visible = open
                end)

                UpdateColor()

                local CP = {}
                function CP:Set(c) color = c; h, s, v = Color3.toHSV(c); UpdateColor() end
                function CP:Get() return color end
                return CP
            end

            -- ── LABEL ──
            function Section:CreateLabel(text)
                New("TextLabel", {
                    Size                  = UDim2.new(1, 0, 0, 24),
                    BackgroundTransparency = 1,
                    Text                  = text or "",
                    Font                  = Theme.FontRegular,
                    TextSize              = 11,
                    TextColor3            = Theme.TextMuted,
                    TextXAlignment        = Enum.TextXAlignment.Left,
                    TextWrapped           = true,
                }, sec)
            end

            -- ── SEPARATOR ──
            function Section:CreateSeparator()
                New("Frame", {
                    Size             = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Theme.Border,
                }, sec)
            end

            return Section
        end

        return Tab
    end

    function Window:Notify(opts)
        VoidUI:Notify(opts)
    end

    return Window
end

VoidUI.Theme = Theme
return VoidUI
