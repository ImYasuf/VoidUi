local function DestroyAllVoidUI()
    local targets = { CoreGui, LocalPlayer:FindFirstChild("PlayerGui") }
    for _, parent in ipairs(targets) do
        if parent then
            for _, child in ipairs(parent:GetChildren()) do
                if child.Name:match("^VoidUI") then
                    child:Destroy()
                end
            end
        end
    end
end
DestroyAllVoidUI()

