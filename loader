    local function SetActiveTab(tab)
        if activeTab == tab then return end

        -- Slide out old page
        if activeTab then
            Tween(activeTab._btn, {
                BackgroundColor3    = Color3.fromRGB(0, 0, 0),
                BackgroundTransparency = 1,
                TextColor3          = Theme.TextMuted,
            })
            Tween(activeTab._indicator, { BackgroundTransparency = 1 })
            -- Slide old page out to the left
            Tween(activeTab._page, { Position = UDim2.new(-0.05, 0, 0, 0), BackgroundTransparency = 1 }, Theme.TweenSlow)
            task.delay(0.2, function()
                if activeTab then activeTab._page.Visible = false end
            end)
        end

        activeTab = tab

        -- Slide in new page from right
        tab._page.Position = UDim2.new(0.05, 0, 0, 0)
        tab._page.Visible = true
        Tween(tab._page, { Position = UDim2.new(0, 0, 0, 0) }, Theme.TweenSlow)

        Tween(tab._btn, {
            BackgroundColor3    = Theme.SurfaceAlt,
            BackgroundTransparency = 0,
            TextColor3          = Theme.Text,
