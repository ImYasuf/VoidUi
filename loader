local NotifHolder

local function EnsureNotifHolder()
    if NotifHolder and NotifHolder.Parent then return end
    local sg = New("ScreenGui", {
        Name           = "VoidUI_Notifs",
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    pcall(function() sg.Parent = CoreGui end)
    if not sg.Parent then sg.Parent = LocalPlayer.PlayerGui end

    NotifHolder = New("Frame", {
        Size                  = UDim2.new(0, 320, 1, -20),
        Position              = UDim2.new(1, -330, 0, 10),
        BackgroundTransparency = 1,
        AnchorPoint           = Vector2.new(0, 0),
    }, sg)
    ListLayout(NotifHolder, Enum.FillDirection.Vertical, 8,
        Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)

    local lp = Instance.new("UIPadding")
    lp.PaddingBottom = UDim.new(0, 10)
    lp.Parent = NotifHolder
end

-- Tracks current notification count for stacking offset
local notifCount = 0

function VoidUI:Notify(options)
    EnsureNotifHolder()
    options = options or {}
    local title    = options.Title    or "VoidUI"
    local desc     = options.Desc     or ""
    local duration = options.Duration or 4
    local ntype    = options.Type     or "Info"

    local typeColor = ({
        Info    = Theme.Info,
        Success = Theme.Success,
        Warning = Theme.Warning,
        Error   = Theme.Error,
    })[ntype] or Theme.Info

    notifCount += 1
    local myIndex = notifCount

    -- Card slides in from the right
    local card = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 72),
        BackgroundColor3 = Theme.Surface,
        ClipsDescendants = true,
        Position         = UDim2.new(1, 20, 0, 0),  -- starts off-screen right
    }, NotifHolder)
    Corner(card, Theme.CornerLarge)
    Stroke(card, Theme.Border)

    -- Slight scale offset for stacking visual depth
    local stackOffset = math.min((notifCount - 1) * 2, 6)
    card.Size = UDim2.new(1, -stackOffset, 0, 72)

    -- Colored left accent bar
    local accentBar = New("Frame", {
        Size             = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = typeColor,
    }, card)
    Corner(accentBar, 3)

    -- Text area
    local textFrame = New("Frame", {
        Size                  = UDim2.new(1, -48, 1, 0),
        Position              = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
    }, card)

    New("TextLabel", {
        Size                  = UDim2.new(1, 0, 0, 22),
        Position              = UDim2.new(0, 0, 0, 10),
        BackgroundTransparency = 1,
        Text                  = title,
        Font                  = Theme.Font,
        TextSize              = 13,
        TextColor3            = Theme.Text,
        TextXAlignment        = Enum.TextXAlignment.Left,
    }, textFrame)

    New("TextLabel", {
        Size                  = UDim2.new(1, 0, 0, 28),
        Position              = UDim2.new(0, 0, 0, 32),
        BackgroundTransparency = 1,
        Text                  = desc,
        Font                  = Theme.FontRegular,
        TextSize              = 11,
        TextColor3            = Theme.TextMuted,
        TextXAlignment        = Enum.TextXAlignment.Left,
        TextWrapped           = true,
    }, textFrame)

    -- Close (X) button
    local closeX = New("TextButton", {
        Size             = UDim2.new(0, 22, 0, 22),
        Position         = UDim2.new(1, -28, 0, 6),
        BackgroundColor3 = Color3.fromRGB(35, 35, 35),
        Text             = "×",
        Font             = Theme.Font,
        TextSize         = 14,
        TextColor3       = Theme.TextMuted,
        AutoButtonColor  = false,
        ZIndex           = 5,
    }, card)
    Corner(closeX, Theme.CornerSmall)
    closeX.MouseEnter:Connect(function()
        Tween(closeX, { BackgroundColor3 = Theme.Error, TextColor3 = Color3.new(1,1,1) })
    end)
    closeX.MouseLeave:Connect(function()
        Tween(closeX, { BackgroundColor3 = Color3.fromRGB(35,35,35), TextColor3 = Theme.TextMuted })
    end)

    -- Progress bar
    local prog = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 2),
        Position         = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = typeColor,
    }, card)

    local dismissed = false
    local function Dismiss()
        if dismissed then return end
        dismissed = true
        notifCount = math.max(0, notifCount - 1)
        Tween(card, { Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1 }, Theme.TweenSlow)
        task.wait(0.38)
        card:Destroy()
    end

    closeX.MouseButton1Click:Connect(Dismiss)

    -- Slide in from right
    Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
    Tween(prog, { Size = UDim2.new(0, 0, 0, 2) },
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out))

    task.delay(duration, Dismiss)
end

