                    Position              = UDim2.new(0.6, 0, 0, 5),
                    BackgroundTransparency = 1,
                    Text                  = tostring(value) .. suffix,
                    Font                  = Theme.Font,
                    TextSize              = 12,
                    TextColor3            = Theme.AccentDim,
                    TextXAlignment        = Enum.TextXAlignment.Right,
                }, row)

                local track = New("Frame", {
                    Size             = UDim2.new(1, -24, 0, 4),
                    Position         = UDim2.new(0, 12, 0, 38),
                    BackgroundColor3 = Theme.SliderTrack,
                }, row)
                Corner(track, 2)

                local fill = New("Frame", {
                    Size             = UDim2.new((value - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = Theme.SliderFill,
                }, track)
                Corner(fill, 2)

                local thumbSlider = New("Frame", {
                    Size             = UDim2.new(0, 12, 0, 12),
                    Position         = UDim2.new((value - min) / (max - min), -6, 0.5, -6),
                    BackgroundColor3 = Theme.Accent,
                }, track)
                Corner(thumbSlider, 6)

                local dragging = false
                local inputBtn = New("TextButton", {
                    Size                  = UDim2.new(1, 0, 0, 20),
                    Position              = UDim2.new(0, 0, 0, -8),
                    BackgroundTransparency = 1,
                    Text                  = "",
                }, track)

                local function UpdateSlider(input)
                    local trackPos  = track.AbsolutePosition.X
                    local trackSize = track.AbsoluteSize.X
                    local rel       = math.clamp((input.Position.X - trackPos) / trackSize, 0, 1)
                    local raw       = min + (max - min) * rel
                    local fmt       = "%." .. decimals .. "f"
                    value           = tonumber(string.format(fmt, raw))
                    fill.Size               = UDim2.new(rel, 0, 1, 0)
                    thumbSlider.Position    = UDim2.new(rel, -6, 0.5, -6)
                    valLabel.Text           = tostring(value) .. suffix
                    callback(value)
                end

                inputBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true; UpdateSlider(input)
                    end
                end)
                inputBtn.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        UpdateSlider(input)
                    end
                end)

                local Slider = {}
                function Slider:Set(val)
                    value = math.clamp(val, min, max)
                    local rel = (value - min) / (max - min)
                    fill.Size            = UDim2.new(rel, 0, 1, 0)
                    thumbSlider.Position = UDim2.new(rel, -6, 0.5, -6)
                    valLabel.Text        = tostring(value) .. suffix
                    callback(value)
                end
                function Slider:Get() return value end
                return Slider
            end

