                openBtn.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        dropFrame.Visible = true
                        local targetH = math.min(#items * 32 + 8, 160)
                        Tween(dropFrame, { Size = UDim2.new(1, 0, 0, targetH) })
                        Tween(arrow, { Rotation = 180 })
                    else
                        Tween(dropFrame, { Size = UDim2.new(1, 0, 0, 0) })
                        Tween(arrow, { Rotation = 0 })
                        task.wait(0.2)
                        dropFrame.Visible = false
                    end
                end)

                local Dropdown = {}
                function Dropdown:Set(val) selected = val; selLabel.Text = val; callback(val); RebuildItems() end
                function Dropdown:Get() return selected end
                function Dropdown:SetItems(newItems) items = newItems; RebuildItems() end
                return Dropdown
            end

