-- ─────────────────────────────────────────────
--  Theme
-- ─────────────────────────────────────────────
local Theme = {
    Background    = Color3.fromRGB(10,  10,  10),
    Surface       = Color3.fromRGB(18,  18,  18),
    SurfaceAlt    = Color3.fromRGB(24,  24,  24),
    Border        = Color3.fromRGB(40,  40,  40),
    Accent        = Color3.fromRGB(220, 220, 220),
    AccentDim     = Color3.fromRGB(130, 130, 130),
    Text          = Color3.fromRGB(230, 230, 230),
    TextMuted     = Color3.fromRGB(120, 120, 120),
    TextDisabled  = Color3.fromRGB(60,  60,  60),
    Success       = Color3.fromRGB(80,  200, 120),
    Warning       = Color3.fromRGB(220, 180, 60),
    Error         = Color3.fromRGB(220, 70,  70),
    Info          = Color3.fromRGB(80,  160, 220),
    ToggleOn      = Color3.fromRGB(220, 220, 220),
    ToggleOff     = Color3.fromRGB(45,  45,  45),
    SliderFill    = Color3.fromRGB(200, 200, 200),
    SliderTrack   = Color3.fromRGB(35,  35,  35),
    Font          = Enum.Font.GothamBold,
    FontRegular   = Enum.Font.Gotham,
    FontLight     = Enum.Font.GothamSemibold,
    CornerSmall   = 4,
    CornerMedium  = 6,
    CornerLarge   = 10,
    TweenInfo     = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
