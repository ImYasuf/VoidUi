}

-- ─────────────────────────────────────────────
--  Utility
-- ─────────────────────────────────────────────
local function Tween(obj, props, info)
    TweenService:Create(obj, info or Theme.TweenInfo, props):Play()
end

local function Corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or Theme.CornerMedium)
    c.Parent = parent
    return c
end

local function Stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Border
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function Padding(parent, all, top, bottom, left, right)
    local p = Instance.new("UIPadding")
    if all then
        p.PaddingTop    = UDim.new(0, all)
        p.PaddingBottom = UDim.new(0, all)
        p.PaddingLeft   = UDim.new(0, all)
        p.PaddingRight  = UDim.new(0, all)
    else
        p.PaddingTop    = UDim.new(0, top    or 0)
        p.PaddingBottom = UDim.new(0, bottom or 0)
        p.PaddingLeft   = UDim.new(0, left   or 0)
        p.PaddingRight  = UDim.new(0, right  or 0)
    end
    p.Parent = parent
    return p
end

local function ListLayout(parent, dir, padding, halign, valign)
    local l = Instance.new("UIListLayout")
    l.FillDirection       = dir    or Enum.FillDirection.Vertical
    l.Padding             = UDim.new(0, padding or 0)
    l.HorizontalAlignment = halign or Enum.HorizontalAlignment.Left
    l.VerticalAlignment   = valign or Enum.VerticalAlignment.Top
    l.SortOrder           = Enum.SortOrder.LayoutOrder
    l.Parent              = parent
    return l
end

local function New(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    if parent then obj.Parent = parent end
    return obj
end

local function MakeDraggable(frame, handle)
    local dragging, dragStart, startPos = false, nil, nil
    handle = handle or frame

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = input.Position
            startPos  = frame.Position
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function MakeResizable(frame, minSize, maxSize)
    minSize = minSize or Vector2.new(300, 200)
    maxSize = maxSize or Vector2.new(900, 700)

    local handle = New("TextButton", {
        Size            = UDim2.new(0, 16, 0, 16),
        Position        = UDim2.new(1, -16, 1, -16),
        BackgroundColor3 = Theme.Border,
        Text            = "",
        ZIndex          = 10,
        AutoButtonColor = false,
    }, frame)
    Corner(handle, 2)

    -- Resize icon
    New("ImageLabel", {
        Size              = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Image             = "rbxassetid://7072718362",
        ImageColor3       = Theme.TextMuted,
    }, handle)

    local resizing, startMouse, startSize = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing   = true
            startMouse = input.Position
            startSize  = frame.AbsoluteSize
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - startMouse
            local newW  = math.clamp(startSize.X + delta.X, minSize.X, maxSize.X)
            local newH  = math.clamp(startSize.Y + delta.Y, minSize.Y, maxSize.Y)
            frame.Size  = UDim2.new(0, newW, 0, newH)
        end
    end)
end

-- ─────────────────────────────────────────────
--  Notification System
-- ─────────────────────────────────────────────
local NotifHolder

local function EnsureNotifHolder()
    if NotifHolder and NotifHolder.Parent then return end
    local sg = New("ScreenGui", {
        Name             = "VoidUI_Notifs",
        ResetOnSpawn     = false,
        ZIndexBehavior   = Enum.ZIndexBehavior.Sibling,
    })
    pcall(function() sg.Parent = CoreGui end)
    if not sg.Parent then sg.Parent = LocalPlayer.PlayerGui end

    NotifHolder = New("Frame", {
        Size            = UDim2.new(0, 320, 1, -20),
        Position        = UDim2.new(1, -330, 0, 10),
        BackgroundTransparency = 1,
        AnchorPoint     = Vector2.new(0, 0),
    }, sg)
    ListLayout(NotifHolder, Enum.FillDirection.Vertical, 8,
        Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)

    local lp = Instance.new("UIPadding")
    lp.PaddingBottom = UDim.new(0, 10)
    lp.Parent = NotifHolder
end

function VoidUI:Notify(options)
    EnsureNotifHolder()
    options = options or {}
    local title    = options.Title    or "VoidUI"
    local desc     = options.Desc     or ""
    local duration = options.Duration or 4
    local ntype    = options.Type     or "Info"  -- Info | Success | Warning | Error

    local typeColor = ({
        Info    = Theme.Info,
        Success = Theme.Success,
        Warning = Theme.Warning,
        Error   = Theme.Error,
    })[ntype] or Theme.Info

    -- Card
    local card = New("Frame", {
        Size            = UDim2.new(1, 0, 0, 70),
        BackgroundColor3 = Theme.Surface,
        ClipsDescendants = true,
    }, NotifHolder)
    Corner(card, Theme.CornerLarge)
    Stroke(card, Theme.Border)

    -- Accent bar
    New("Frame", {
        Size            = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = typeColor,
    }, card)
    Corner(New("Frame", {
        Size            = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = typeColor,
    }, card), 3)

    -- Text area
    local textFrame = New("Frame", {
        Size     = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
    }, card)

    New("TextLabel", {
        Size            = UDim2.new(1, 0, 0, 22),
        Position        = UDim2.new(0, 0, 0, 10),
        BackgroundTransparency = 1,
        Text            = title,
        Font            = Theme.Font,
        TextSize        = 13,
        TextColor3      = Theme.Text,
        TextXAlignment  = Enum.TextXAlignment.Left,
    }, textFrame)

    New("TextLabel", {
        Size            = UDim2.new(1, 0, 0, 28),
        Position        = UDim2.new(0, 0, 0, 32),
        BackgroundTransparency = 1,
        Text            = desc,
        Font            = Theme.FontRegular,
        TextSize        = 11,
        TextColor3      = Theme.TextMuted,
        TextXAlignment  = Enum.TextXAlignment.Left,
        TextWrapped     = true,
    }, textFrame)

    -- Progress bar
    local prog = New("Frame", {
        Size            = UDim2.new(1, 0, 0, 2),
        Position        = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = typeColor,
    }, card)

    -- Animate in
    card.BackgroundTransparency = 1
    Tween(card, { BackgroundTransparency = 0 }, Theme.TweenInfo)
    Tween(prog, { Size = UDim2.new(0, 0, 0, 2) },
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out))

    task.delay(duration, function()
        Tween(card, { BackgroundTransparency = 1 }, Theme.TweenInfo)
        task.wait(0.2)
        card:Destroy()
    end)
end

-- ─────────────────────────────────────────────
--  Window Constructor
-- ─────────────────────────────────────────────
function VoidUI:CreateWindow(options)
    options = options or {}
    local title   = options.Title   or "VoidUI"
    local size    = options.Size    or UDim2.new(0, 560, 0, 420)
    local pos     = options.Position or UDim2.new(0.5, -280, 0.5, -210)

    -- ScreenGui
    local sg = New("ScreenGui", {
        Name           = "VoidUI_" .. title,
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    pcall(function() sg.Parent = CoreGui end)
    if not sg.Parent then sg.Parent = LocalPlayer.PlayerGui end

    -- Main window frame
    local win = New("Frame", {
        Size            = size,
        Position        = pos,
        BackgroundColor3 = Theme.Background,
        ClipsDescendants = false,
    }, sg)
    Corner(win, Theme.CornerLarge)
    Stroke(win, Theme.Border)

    -- Shadow
    local shadow = New("ImageLabel", {
        Size              = UDim2.new(1, 40, 1, 40),
        Position          = UDim2.new(0, -20, 0, -20),
        BackgroundTransparency = 1,
        Image             = "rbxassetid://5554236805",
        ImageColor3       = Color3.new(0,0,0),
        ImageTransparency = 0.5,
        ZIndex            = -1,
    }, win)

    -- ── Title Bar ──
    local titleBar = New("Frame", {
        Size            = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Theme.Surface,
    }, win)
    Corner(titleBar, Theme.CornerLarge)

    -- Bottom fill to cancel corner on bottom of titlebar
    New("Frame", {
        Size            = UDim2.new(1, 0, 0, Theme.CornerLarge),
        Position        = UDim2.new(0, 0, 1, -Theme.CornerLarge),
        BackgroundColor3 = Theme.Surface,
    }, titleBar)

    -- Logo dot
    New("Frame", {
        Size            = UDim2.new(0, 8, 0, 8),
        Position        = UDim2.new(0, 14, 0.5, -4),
        BackgroundColor3 = Theme.Accent,
    }, titleBar)

    New("TextLabel", {
        Size            = UDim2.new(1, -100, 1, 0),
        Position        = UDim2.new(0, 28, 0, 0),
        BackgroundTransparency = 1,
        Text            = title,
        Font            = Theme.Font,
        TextSize        = 13,
        TextColor3      = Theme.Text,
        TextXAlignment  = Enum.TextXAlignment.Left,
    }, titleBar)

    -- Close button
    local closeBtn = New("TextButton", {
        Size            = UDim2.new(0, 28, 0, 28),
        Position        = UDim2.new(1, -36, 0.5, -14),
        BackgroundColor3 = Color3.fromRGB(40, 40, 40),
        Text            = "✕",
        Font            = Theme.Font,
        TextSize        = 11,
        TextColor3      = Theme.TextMuted,
        AutoButtonColor = false,
    }, titleBar)
    Corner(closeBtn, Theme.CornerSmall)
    closeBtn.MouseEnter:Connect(function()
        Tween(closeBtn, { BackgroundColor3 = Theme.Error, TextColor3 = Color3.new(1,1,1) })
    end)
    closeBtn.MouseLeave:Connect(function()
        Tween(closeBtn, { BackgroundColor3 = Color3.fromRGB(40,40,40), TextColor3 = Theme.TextMuted })
    end)
    closeBtn.MouseButton1Click:Connect(function()
        Tween(win, { BackgroundTransparency = 1 }, Theme.TweenSlow)
        task.wait(0.36)
        sg:Destroy()
    end)

    -- Minimize button
    local minimized = false
    local minBtn = New("TextButton", {
        Size            = UDim2.new(0, 28, 0, 28),
        Position        = UDim2.new(1, -70, 0.5, -14),
        BackgroundColor3 = Color3.fromRGB(40, 40, 40),
        Text            = "─",
        Font            = Theme.Font,
        TextSize        = 11,
        TextColor3      = Theme.TextMuted,
        AutoButtonColor = false,
    }, titleBar)
    Corner(minBtn, Theme.CornerSmall)
    minBtn.MouseEnter:Connect(function()
        Tween(minBtn, { BackgroundColor3 = Color3.fromRGB(60,60,60), TextColor3 = Theme.Text })
    end)
    minBtn.MouseLeave:Connect(function()
        Tween(minBtn, { BackgroundColor3 = Color3.fromRGB(40,40,40), TextColor3 = Theme.TextMuted })
    end)

    -- Body (contains sidebar + content)
    local body = New("Frame", {
        Size            = UDim2.new(1, 0, 1, -44),
        Position        = UDim2.new(0, 0, 0, 44),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, win)

    -- Sidebar
    local sidebar = New("Frame", {
        Size            = UDim2.new(0, 130, 1, 0),
        BackgroundColor3 = Theme.Surface,
    }, body)

    -- Bottom-left corner fix
    New("Frame", {
        Size            = UDim2.new(1, 0, 0, Theme.CornerLarge),
        Position        = UDim2.new(0, 0, 1, -Theme.CornerLarge),
        BackgroundColor3 = Theme.Surface,
    }, sidebar)

    local tabList = New("ScrollingFrame", {
        Size            = UDim2.new(1, 0, 1, -10),
        Position        = UDim2.new(0, 0, 0, 10),
        BackgroundTransparency = 1,
        ScrollBarThickness = 0,
        CanvasSize      = UDim2.new(0, 0, 0, 0),
    }, sidebar)
    ListLayout(tabList, Enum.FillDirection.Vertical, 2)
    Padding(tabList, nil, 0, 0, 8, 8)

    -- Content area
    local contentArea = New("Frame", {
        Size            = UDim2.new(1, -130, 1, 0),
        Position        = UDim2.new(0, 130, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, body)

    -- Divider line
    New("Frame", {
        Size            = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = Theme.Border,
    }, body)

    -- Draggable & Resizable
    MakeDraggable(win, titleBar)
    MakeResizable(win)

    -- Minimize logic
    local savedSize
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            savedSize = win.Size
            Tween(win, { Size = UDim2.new(0, savedSize.X.Offset, 0, 44) }, Theme.TweenSlow)
            Tween(body, { BackgroundTransparency = 1 })
            body.Visible = false
        else
            body.Visible = true
            Tween(win, { Size = savedSize }, Theme.TweenSlow)
        end
    end)

    -- ── Window Object ──
    local Window = {}
    local tabs = {}
    local activeTab = nil

    local function SetActiveTab(tab)
        if activeTab == tab then return end
        if activeTab then
            Tween(activeTab._btn, {
                BackgroundColor3 = Color3.fromRGB(0,0,0),
                BackgroundTransparency = 1,
                TextColor3 = Theme.TextMuted,
            })
            activeTab._page.Visible = false
        end
        activeTab = tab
        Tween(tab._btn, {
            BackgroundColor3 = Theme.SurfaceAlt,
            BackgroundTransparency = 0,
            TextColor3 = Theme.Text,
        })
        tab._page.Visible = true
    end

    -- ── CreateTab ──
    function Window:CreateTab(options)
        options = type(options) == "string" and { Name = options } or options
        local name = options.Name or "Tab"
        local icon = options.Icon or ""

        -- Tab button
        local btn = New("TextButton", {
            Size            = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Color3.fromRGB(0,0,0),
            BackgroundTransparency = 1,
            Text            = (icon ~= "" and icon .. "  " or "") .. name,
            Font            = Theme.FontLight,
            TextSize        = 12,
            TextColor3      = Theme.TextMuted,
            AutoButtonColor = false,
            TextXAlignment  = Enum.TextXAlignment.Left,
        }, tabList)
        Corner(btn, Theme.CornerSmall)
        Padding(btn, nil, 0, 0, 10, 0)

        -- Selection indicator
        local indicator = New("Frame", {
            Size            = UDim2.new(0, 2, 0.6, 0),
            Position        = UDim2.new(0, 0, 0.2, 0),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1,
        }, btn)
        Corner(indicator, 2)

        btn.MouseEnter:Connect(function()
            if activeTab and activeTab._btn == btn then return end
            Tween(btn, { TextColor3 = Theme.AccentDim })
        end)
        btn.MouseLeave:Connect(function()
            if activeTab and activeTab._btn == btn then return end
            Tween(btn, { TextColor3 = Theme.TextMuted })
        end)

        -- Page
        local page = New("ScrollingFrame", {
            Size              = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Border,
            CanvasSize        = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible           = false,
        }, contentArea)
        Padding(page, nil, 10, 10, 12, 12)
        local pageLayout = ListLayout(page, Enum.FillDirection.Vertical, 6)

        local Tab = { _btn = btn, _page = page, _layout = pageLayout }
        table.insert(tabs, Tab)

        btn.MouseButton1Click:Connect(function()
            SetActiveTab(Tab)
            Tween(indicator, { BackgroundTransparency = 0 })
            for _, t in ipairs(tabs) do
                if t ~= Tab then
                    Tween(t._btn:FindFirstChild("Frame") or Instance.new("Frame"),
                        { BackgroundTransparency = 1 })
                end
            end
        end)

        if #tabs == 1 then
            SetActiveTab(Tab)
            indicator.BackgroundTransparency = 0
        end

        -- Update canvas
        pageLayout.Changed:Connect(function()
            tabList.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 20)
        end)

        -- ── Element Helpers ──

        local function MakeSection(labelText)
            local sec = New("Frame", {
                Size            = UDim2.new(1, 0, 0, 0),
                BackgroundTransparency = 1,
                AutomaticSize   = Enum.AutomaticSize.Y,
            }, page)
            local layout = ListLayout(sec, Enum.FillDirection.Vertical, 4)
            Padding(sec, nil, 4, 4, 0, 0)

            if labelText then
                local header = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                }, sec)
                New("TextLabel", {
                    Size            = UDim2.new(0, 0, 1, 0),
                    AutomaticSize   = Enum.AutomaticSize.X,
                    BackgroundTransparency = 1,
                    Text            = string.upper(labelText),
                    Font            = Theme.Font,
                    TextSize        = 9,
                    TextColor3      = Theme.TextMuted,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                }, header)
                New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 1),
                    Position        = UDim2.new(0, 0, 1, -1),
                    BackgroundColor3 = Theme.Border,
                }, header)
            end

            return sec, layout
        end

        -- ── CreateSection ──
        function Tab:CreateSection(name)
            local sec, _ = MakeSection(name)
            local Section = {}

            -- ── Button ──
            function Section:CreateButton(opts)
                opts = type(opts) == "string" and { Name = opts } or opts
                local label    = opts.Name     or "Button"
                local callback = opts.Callback or function() end

                local row = New("TextButton", {
                    Size            = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = Theme.SurfaceAlt,
                    Text            = "",
                    AutoButtonColor = false,
                }, sec)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                New("TextLabel", {
                    Size            = UDim2.new(1, -16, 1, 0),
                    Position        = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = label,
                    Font            = Theme.FontLight,
                    TextSize        = 12,
                    TextColor3      = Theme.Text,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                }, row)

                -- Arrow icon
                New("TextLabel", {
                    Size            = UDim2.new(0, 20, 1, 0),
                    Position        = UDim2.new(1, -24, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = "›",
                    Font            = Theme.Font,
                    TextSize        = 16,
                    TextColor3      = Theme.TextMuted,
                }, row)

                row.MouseEnter:Connect(function()
                    Tween(row, { BackgroundColor3 = Color3.fromRGB(32,32,32) })
                end)
                row.MouseLeave:Connect(function()
                    Tween(row, { BackgroundColor3 = Theme.SurfaceAlt })
                end)
                row.MouseButton1Click:Connect(function()
                    Tween(row, { BackgroundColor3 = Color3.fromRGB(50,50,50) })
                    task.wait(0.1)
                    Tween(row, { BackgroundColor3 = Theme.SurfaceAlt })
                    callback()
                end)

                return row
            end

            -- ── Toggle ──
            function Section:CreateToggle(opts)
                opts = type(opts) == "string" and { Name = opts } or opts
                local label    = opts.Name     or "Toggle"
                local default  = opts.Default  or false
                local callback = opts.Callback or function() end

                local state = default
                local row = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = Theme.SurfaceAlt,
                }, sec)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                New("TextLabel", {
                    Size            = UDim2.new(1, -56, 1, 0),
                    Position        = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = label,
                    Font            = Theme.FontLight,
                    TextSize        = 12,
                    TextColor3      = Theme.Text,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                }, row)

                -- Track
                local track = New("Frame", {
                    Size            = UDim2.new(0, 36, 0, 18),
                    Position        = UDim2.new(1, -48, 0.5, -9),
                    BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff,
                }, row)
                Corner(track, 9)

                -- Thumb
                local thumb = New("Frame", {
                    Size            = UDim2.new(0, 12, 0, 12),
                    Position        = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
                    BackgroundColor3 = state and Theme.Background or Theme.AccentDim,
                }, track)
                Corner(thumb, 6)

                local btn = New("TextButton", {
                    Size            = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text            = "",
                }, row)

                local function UpdateToggle()
                    Tween(track, { BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff })
                    Tween(thumb, {
                        Position = state
                            and UDim2.new(1, -15, 0.5, -6)
                            or  UDim2.new(0, 3, 0.5, -6),
                        BackgroundColor3 = state and Theme.Background or Theme.AccentDim,
                    })
                end

                btn.MouseButton1Click:Connect(function()
                    state = not state
                    UpdateToggle()
                    callback(state)
                end)

                local Toggle = {}
                function Toggle:Set(val)
                    state = val
                    UpdateToggle()
                    callback(state)
                end
                function Toggle:Get() return state end

                return Toggle
            end

            -- ── Slider ──
            function Section:CreateSlider(opts)
                opts = type(opts) == "string" and { Name = opts } or opts
                local label    = opts.Name     or "Slider"
                local min      = opts.Min      or 0
                local max      = opts.Max      or 100
                local default  = opts.Default  or min
                local decimals = opts.Decimals or 0
                local suffix   = opts.Suffix   or ""
                local callback = opts.Callback or function() end

                local value = math.clamp(default, min, max)

                local row = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 52),
                    BackgroundColor3 = Theme.SurfaceAlt,
                }, sec)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                -- Header
                local lbl = New("TextLabel", {
                    Size            = UDim2.new(0.6, 0, 0, 24),
                    Position        = UDim2.new(0, 12, 0, 4),
                    BackgroundTransparency = 1,
                    Text            = label,
                    Font            = Theme.FontLight,
                    TextSize        = 12,
                    TextColor3      = Theme.Text,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                }, row)

                local valLabel = New("TextLabel", {
                    Size            = UDim2.new(0.4, -12, 0, 24),
                    Position        = UDim2.new(0.6, 0, 0, 4),
                    BackgroundTransparency = 1,
                    Text            = tostring(value) .. suffix,
                    Font            = Theme.Font,
                    TextSize        = 12,
                    TextColor3      = Theme.AccentDim,
                    TextXAlignment  = Enum.TextXAlignment.Right,
                }, row)

                -- Track
                local track = New("Frame", {
                    Size            = UDim2.new(1, -24, 0, 4),
                    Position        = UDim2.new(0, 12, 0, 36),
                    BackgroundColor3 = Theme.SliderTrack,
                }, row)
                Corner(track, 2)

                local fill = New("Frame", {
                    Size            = UDim2.new((value - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = Theme.SliderFill,
                }, track)
                Corner(fill, 2)

                -- Thumb
                local thumbSlider = New("Frame", {
                    Size            = UDim2.new(0, 12, 0, 12),
                    Position        = UDim2.new((value - min) / (max - min), -6, 0.5, -6),
                    BackgroundColor3 = Theme.Accent,
                }, track)
                Corner(thumbSlider, 6)

                local dragging = false
                local inputBtn = New("TextButton", {
                    Size            = UDim2.new(1, 0, 0, 20),
                    Position        = UDim2.new(0, 0, 0, -8),
                    BackgroundTransparency = 1,
                    Text            = "",
                }, track)

                local function UpdateSlider(input)
                    local trackPos  = track.AbsolutePosition.X
                    local trackSize = track.AbsoluteSize.X
                    local rel = math.clamp((input.Position.X - trackPos) / trackSize, 0, 1)
                    local raw = min + (max - min) * rel
                    local fmt = "%." .. decimals .. "f"
                    value = tonumber(string.format(fmt, raw))
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    thumbSlider.Position = UDim2.new(rel, -6, 0.5, -6)
                    valLabel.Text = tostring(value) .. suffix
                    callback(value)
                end

                inputBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        UpdateSlider(input)
                    end
                end)
                inputBtn.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        UpdateSlider(input)
                    end
                end)

                local Slider = {}
                function Slider:Set(val)
                    value = math.clamp(val, min, max)
                    local rel = (value - min) / (max - min)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    thumbSlider.Position = UDim2.new(rel, -6, 0.5, -6)
                    valLabel.Text = tostring(value) .. suffix
                    callback(value)
                end
                function Slider:Get() return value end
                return Slider
            end

            -- ── Dropdown ──
            function Section:CreateDropdown(opts)
                opts = type(opts) == "string" and { Name = opts } or opts
                local label    = opts.Name     or "Dropdown"
                local items    = opts.Items    or {}
                local default  = opts.Default  or (items[1] or "Select...")
                local callback = opts.Callback or function() end

                local selected = default
                local open = false

                local container = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 36),
                    BackgroundTransparency = 1,
                    ClipsDescendants = false,
                    ZIndex          = 5,
                }, sec)

                local row = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = Theme.SurfaceAlt,
                    ZIndex          = 5,
                }, container)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                New("TextLabel", {
                    Size            = UDim2.new(0.5, 0, 1, 0),
                    Position        = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = label,
                    Font            = Theme.FontLight,
                    TextSize        = 12,
                    TextColor3      = Theme.Text,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                    ZIndex          = 5,
                }, row)

                local selLabel = New("TextLabel", {
                    Size            = UDim2.new(0.4, 0, 1, 0),
                    Position        = UDim2.new(0.5, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = selected,
                    Font            = Theme.Font,
                    TextSize        = 11,
                    TextColor3      = Theme.AccentDim,
                    TextXAlignment  = Enum.TextXAlignment.Right,
                    ZIndex          = 5,
                }, row)

                local arrow = New("TextLabel", {
                    Size            = UDim2.new(0, 20, 1, 0),
                    Position        = UDim2.new(1, -24, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = "▾",
                    Font            = Theme.Font,
                    TextSize        = 12,
                    TextColor3      = Theme.TextMuted,
                    ZIndex          = 5,
                }, row)

                -- Dropdown list
                local dropFrame = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 0),
                    Position        = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = Theme.SurfaceAlt,
                    ClipsDescendants = true,
                    ZIndex          = 10,
                    Visible         = false,
                }, container)
                Corner(dropFrame, Theme.CornerMedium)
                Stroke(dropFrame, Theme.Border)

                local dropList = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 0),
                    BackgroundTransparency = 1,
                    AutomaticSize   = Enum.AutomaticSize.Y,
                    ZIndex          = 10,
                }, dropFrame)
                ListLayout(dropList, Enum.FillDirection.Vertical, 2)
                Padding(dropList, 4)

                local function RebuildItems()
                    for _, c in ipairs(dropList:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    for _, item in ipairs(items) do
                        local itemBtn = New("TextButton", {
                            Size            = UDim2.new(1, 0, 0, 28),
                            BackgroundColor3 = item == selected
                                and Color3.fromRGB(35,35,35)
                                or  Color3.fromRGB(0,0,0),
                            BackgroundTransparency = item == selected and 0 or 1,
                            Text            = item,
                            Font            = Theme.FontLight,
                            TextSize        = 11,
                            TextColor3      = item == selected and Theme.Text or Theme.TextMuted,
                            AutoButtonColor = false,
                            ZIndex          = 10,
                        }, dropList)
                        Corner(itemBtn, Theme.CornerSmall)
                        itemBtn.MouseEnter:Connect(function()
                            Tween(itemBtn, { BackgroundColor3 = Color3.fromRGB(35,35,35), BackgroundTransparency = 0 })
                        end)
                        itemBtn.MouseLeave:Connect(function()
                            if selected ~= item then
                                Tween(itemBtn, { BackgroundTransparency = 1 })
                            end
                        end)
                        itemBtn.MouseButton1Click:Connect(function()
                            selected = item
                            selLabel.Text = selected
                            callback(selected)
                            -- Close
                            open = false
                            Tween(dropFrame, { Size = UDim2.new(1, 0, 0, 0) })
                            task.wait(0.2)
                            dropFrame.Visible = false
                            RebuildItems()
                        end)
                    end
                end
                RebuildItems()

                local openBtn = New("TextButton", {
                    Size            = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text            = "",
                    ZIndex          = 6,
                }, row)
                openBtn.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        dropFrame.Visible = true
                        local targetH = math.min(#items * 32 + 8, 160)
                        Tween(dropFrame, { Size = UDim2.new(1, 0, 0, targetH) })
                        Tween(arrow, { Rotation = 180 })
                    else
                        Tween(dropFrame, { Size = UDim2.new(1, 0, 0, 0) })
                        Tween(arrow, { Rotation = 0 })
                        task.wait(0.2)
                        dropFrame.Visible = false
                    end
                end)

                local Dropdown = {}
                function Dropdown:Set(val)
                    selected = val
                    selLabel.Text = val
                    callback(val)
                    RebuildItems()
                end
                function Dropdown:Get() return selected end
                function Dropdown:SetItems(newItems)
                    items = newItems
                    RebuildItems()
                end
                return Dropdown
            end

            -- ── TextInput ──
            function Section:CreateTextInput(opts)
                opts = type(opts) == "string" and { Name = opts } or opts
                local label       = opts.Name        or "Input"
                local placeholder = opts.Placeholder or "Type here..."
                local default     = opts.Default     or ""
                local callback    = opts.Callback    or function() end

                local row = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = Theme.SurfaceAlt,
                }, sec)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                New("TextLabel", {
                    Size            = UDim2.new(0.4, 0, 1, 0),
                    Position        = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = label,
                    Font            = Theme.FontLight,
                    TextSize        = 12,
                    TextColor3      = Theme.Text,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                }, row)

                local input = New("TextBox", {
                    Size            = UDim2.new(0.55, 0, 0, 22),
                    Position        = UDim2.new(0.42, 0, 0.5, -11),
                    BackgroundColor3 = Theme.Background,
                    Text            = default,
                    PlaceholderText = placeholder,
                    Font            = Theme.FontRegular,
                    TextSize        = 11,
                    TextColor3      = Theme.Text,
                    PlaceholderColor3 = Theme.TextDisabled,
                    ClearTextOnFocus = false,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                }, row)
                Corner(input, Theme.CornerSmall)
                Stroke(input, Theme.Border)
                Padding(input, nil, 0, 0, 8, 8)

                input.Focused:Connect(function()
                    Tween(input, { BackgroundColor3 = Color3.fromRGB(28,28,28) })
                    Stroke(input).Color = Theme.AccentDim
                end)
                input.FocusLost:Connect(function(enter)
                    Tween(input, { BackgroundColor3 = Theme.Background })
                    Stroke(input).Color = Theme.Border
                    callback(input.Text, enter)
                end)

                local Input = {}
                function Input:Set(val)
                    input.Text = val
                    callback(val, false)
                end
                function Input:Get() return input.Text end
                return Input
            end

            -- ── Keybind ──
            function Section:CreateKeybind(opts)
                opts = type(opts) == "string" and { Name = opts } or opts
                local label    = opts.Name     or "Keybind"
                local default  = opts.Default  or Enum.KeyCode.Unknown
                local callback = opts.Callback or function() end

                local bound   = default
                local waiting = false

                local row = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = Theme.SurfaceAlt,
                }, sec)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                New("TextLabel", {
                    Size            = UDim2.new(0.6, 0, 1, 0),
                    Position        = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = label,
                    Font            = Theme.FontLight,
                    TextSize        = 12,
                    TextColor3      = Theme.Text,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                }, row)

                local keyBtn = New("TextButton", {
                    Size            = UDim2.new(0, 80, 0, 22),
                    Position        = UDim2.new(1, -90, 0.5, -11),
                    BackgroundColor3 = Theme.Background,
                    Text            = bound.Name,
                    Font            = Theme.Font,
                    TextSize        = 10,
                    TextColor3      = Theme.AccentDim,
                    AutoButtonColor = false,
                }, row)
                Corner(keyBtn, Theme.CornerSmall)
                Stroke(keyBtn, Theme.Border)

                keyBtn.MouseButton1Click:Connect(function()
                    waiting = true
                    keyBtn.Text = "..."
                    Tween(keyBtn, { TextColor3 = Theme.Text })
                end)

                UserInputService.InputBegan:Connect(function(input, gp)
                    if not waiting then
                        -- Fire callback when key is pressed
                        if input.KeyCode == bound then
                            callback(bound)
                        end
                        return
                    end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        waiting = false
                        bound   = input.KeyCode
                        keyBtn.Text = bound.Name
                        Tween(keyBtn, { TextColor3 = Theme.AccentDim })
                    end
                end)

                local Keybind = {}
                function Keybind:Set(key)
                    bound = key
                    keyBtn.Text = key.Name
                end
                function Keybind:Get() return bound end
                return Keybind
            end

            -- ── ColorPicker ──
            function Section:CreateColorPicker(opts)
                opts = type(opts) == "string" and { Name = opts } or opts
                local label    = opts.Name     or "Color"
                local default  = opts.Default  or Color3.new(1, 1, 1)
                local callback = opts.Callback or function() end

                local color = default
                local open  = false

                -- HSV state
                local h, s, v = Color3.toHSV(color)

                local container = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 36),
                    BackgroundTransparency = 1,
                    ClipsDescendants = false,
                    ZIndex          = 4,
                }, sec)

                local row = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = Theme.SurfaceAlt,
                    ZIndex          = 4,
                }, container)
                Corner(row, Theme.CornerMedium)
                Stroke(row, Theme.Border)

                New("TextLabel", {
                    Size            = UDim2.new(0.6, 0, 1, 0),
                    Position        = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text            = label,
                    Font            = Theme.FontLight,
                    TextSize        = 12,
                    TextColor3      = Theme.Text,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                    ZIndex          = 4,
                }, row)

                local preview = New("Frame", {
                    Size            = UDim2.new(0, 48, 0, 20),
                    Position        = UDim2.new(1, -60, 0.5, -10),
                    BackgroundColor3 = color,
                    ZIndex          = 4,
                }, row)
                Corner(preview, Theme.CornerSmall)
                Stroke(preview, Theme.Border)

                -- Picker panel
                local panel = New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 160),
                    Position        = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = Theme.Surface,
                    ClipsDescendants = false,
                    ZIndex          = 8,
                    Visible         = false,
                }, container)
                Corner(panel, Theme.CornerMedium)
                Stroke(panel, Theme.Border)

                -- SV square
                local svSquare = New("ImageLabel", {
                    Size            = UDim2.new(0, 120, 0, 120),
                    Position        = UDim2.new(0, 10, 0, 10),
                    BackgroundColor3 = Color3.fromHSV(h, 1, 1),
                    Image           = "rbxassetid://4155801252", -- Saturation/Value gradient
                    ZIndex          = 8,
                }, panel)
                Corner(svSquare, Theme.CornerSmall)

                local svThumb = New("Frame", {
                    Size            = UDim2.new(0, 10, 0, 10),
                    BackgroundColor3 = Color3.new(1,1,1),
                    ZIndex          = 9,
                }, svSquare)
                Corner(svThumb, 5)
                Stroke(svThumb, Color3.new(0,0,0), 1)

                -- Hue bar
                local hueBar = New("ImageLabel", {
                    Size            = UDim2.new(0, 16, 0, 120),
                    Position        = UDim2.new(0, 138, 0, 10),
                    Image           = "rbxassetid://698051777",
                    ZIndex          = 8,
                }, panel)
                Corner(hueBar, Theme.CornerSmall)

                local hueThumb = New("Frame", {
                    Size            = UDim2.new(1, 4, 0, 4),
                    Position        = UDim2.new(0, -2, 0, 0),
                    BackgroundColor3 = Color3.new(1,1,1),
                    ZIndex          = 9,
                }, hueBar)
                Corner(hueThumb, 2)
                Stroke(hueThumb, Color3.new(0,0,0), 1)

                -- RGB readout
                local rgbLabel = New("TextLabel", {
                    Size            = UDim2.new(1, -170, 0, 40),
                    Position        = UDim2.new(0, 162, 0, 10),
                    BackgroundTransparency = 1,
                    Text            = string.format("R: %d\nG: %d\nB: %d",
                        math.round(color.R*255),
                        math.round(color.G*255),
                        math.round(color.B*255)),
                    Font            = Theme.FontRegular,
                    TextSize        = 10,
                    TextColor3      = Theme.TextMuted,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                    ZIndex          = 8,
                }, panel)

                local function UpdateColor()
                    color = Color3.fromHSV(h, s, v)
                    preview.BackgroundColor3 = color
                    svSquare.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                    svThumb.Position = UDim2.new(s, -5, 1 - v, -5)
                    hueThumb.Position = UDim2.new(0, -2, 1 - h, -2)
                    rgbLabel.Text = string.format("R: %d\nG: %d\nB: %d",
                        math.round(color.R*255),
                        math.round(color.G*255),
                        math.round(color.B*255))
                    callback(color)
                end

                -- SV dragging
                local svDrag = false
                local svBtn = New("TextButton", { Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=9 }, svSquare)
                svBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        svDrag = true
                    end
                end)
                svBtn.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then svDrag = false end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if svDrag and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local rel = svSquare.AbsolutePosition
                        local sz  = svSquare.AbsoluteSize
                        s = math.clamp((input.Position.X - rel.X) / sz.X, 0, 1)
                        v = math.clamp(1 - (input.Position.Y - rel.Y) / sz.Y, 0, 1)
                        UpdateColor()
                    end
                end)

                -- Hue dragging
                local hueDrag = false
                local hueBtn = New("TextButton", { Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=9 }, hueBar)
                hueBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = true end
                end)
                hueBtn.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = false end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if hueDrag and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local rel = hueBar.AbsolutePosition
                        local sz  = hueBar.AbsoluteSize
                        h = math.clamp(1 - (input.Position.Y - rel.Y) / sz.Y, 0, 1)
                        UpdateColor()
                    end
                end)

                -- Toggle panel
                local openBtn = New("TextButton", { Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=5 }, row)
                openBtn.MouseButton1Click:Connect(function()
                    open = not open
                    panel.Visible = open
                end)

                UpdateColor()

                local CP = {}
                function CP:Set(c)
                    color = c
                    h, s, v = Color3.toHSV(c)
                    UpdateColor()
                end
                function CP:Get() return color end
                return CP
            end

            -- ── Label ──
            function Section:CreateLabel(text)
                New("TextLabel", {
                    Size            = UDim2.new(1, 0, 0, 24),
                    BackgroundTransparency = 1,
                    Text            = text or "",
                    Font            = Theme.FontRegular,
                    TextSize        = 11,
                    TextColor3      = Theme.TextMuted,
                    TextXAlignment  = Enum.TextXAlignment.Left,
                    TextWrapped     = true,
                }, sec)
            end

            -- ── Separator ──
            function Section:CreateSeparator()
                New("Frame", {
                    Size            = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Theme.Border,
                }, sec)
            end

            return Section
        end

        return Tab
    end

    -- Notify shortcut on window
    function Window:Notify(opts)
        VoidUI:Notify(opts)
    end

    return Window
end

